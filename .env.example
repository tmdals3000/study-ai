# Restart the app after changing settings.
LLM_PROVIDER=claude_cli
LLM_MODEL=sonnet
LLM_PARALLEL=2
# API: LLM_PROVIDER=api, LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# Offline: LLM_PROVIDER=ollama, LLM_MODEL=qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434
# Local sentence-transformers model directory. Empty = Korean/English lexical search.
EMBEDDING_MODEL=
OCR_ENABLED=false
OCR_LANGUAGES=kor+eng
MAX_UPLOAD_MB=100
MAX_PDF_PAGES=2000
# Set a password before Tailscale Serve. Set COOKIE_SECURE=true for HTTPS.
APP_PASSWORD=
COOKIE_SECURE=false
